{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "SympSort: Run Desktop Web App (Flask)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "SympSort: Run CLI Analysis",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/main.py",
            "args": ["--cli"],
            "console": "integratedTerminal",
            "justMyCode": true
        },
        {
            "name": "SympSort: Run Automated Tests",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-v", "tests"],
            "console": "integratedTerminal",
            "justMyCode": true
        }
    ]
}
