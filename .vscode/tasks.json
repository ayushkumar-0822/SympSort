{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "SympSort: Launch Desktop Web App (Flask)",
            "type": "shell",
            "command": "python",
            "args": ["main.py"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "SympSort: Run CLI Report",
            "type": "shell",
            "command": "python",
            "args": ["main.py", "--cli"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "SympSort: Run Automated Tests",
            "type": "shell",
            "command": "pytest",
            "args": ["-v"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        }
    ]
}
