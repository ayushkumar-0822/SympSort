{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!static|css|js|fonts|img|favicon.ico).*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "MPLCONFIGDIR": "/tmp"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  }
}
