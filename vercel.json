{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index.py"
    }
  ],
  "env": {
    "MPLCONFIGDIR": "/tmp/.matplotlib"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "templates/**,static/**,data/**"
    }
  }
}
