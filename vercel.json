{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index?__path__=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index?__path__=/api"
    },
    {
      "source": "/export-csv",
      "destination": "/api/index?__path__=/export-csv"
    },
    {
      "source": "/((?!static|favicon.ico).*)",
      "destination": "/api/index?__path__=/$1"
    }
  ],
  "env": {
    "MPLCONFIGDIR": "/tmp"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "data/**"
    }
  }
}
