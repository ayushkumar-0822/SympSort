{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api",
      "destination": "/api/index?__path__=/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api/index?__path__=/api/:match*"
    },
    {
      "source": "/export-csv",
      "destination": "/api/index?__path__=/export-csv"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "env": {
    "MPLCONFIGDIR": "/tmp"
  },
  "functions": {
    "api/index.py": {
      "includeFiles": "{data,templates}/**"
    }
  }
}
